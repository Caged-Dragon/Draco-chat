VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Optional — improves call reliability across strict/corporate networks.
# Leave blank to use free public STUN servers only (works for most people).
# VITE_TURN_URL=turn:your-turn-server:3478
# VITE_TURN_USERNAME=your-username
# VITE_TURN_CREDENTIAL=your-credential

# Push notifications — this is the PUBLIC half of a VAPID key pair,
# safe to expose client-side. The matching PRIVATE key goes only on
# the Supabase Edge Function (supabase secrets set VAPID_PRIVATE_KEY=...),
# never here. See README for the full setup steps.
